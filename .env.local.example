# ─────────────────────────────────────────────────────────────────────────────
# Stichting Shoma – Environment Variables
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local wordt NOOIT gecommit naar git.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# STICHTING SHOMA – ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local wordt NOOIT gecommit naar git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── SITE CONFIGURATION ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── MOLLIE (DONATIONS) ───────────────────────────────────────────────────────
# Test: https://www.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SUPABASE (DATABASE + AUTH + STORAGE) ─────────────────────────────────────
# From: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Direct database connection
DATABASE_URL=postgresql://postgres:password@xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── RESEND (EMAIL SERVICE) ───────────────────────────────────────────────────
# From: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@shoma.nl
PARTNER_EMAIL=partners@shoma.nl

# ─── IMAGE STORAGE ────────────────────────────────────────────────────────────
# Options: 'local', 'supabase', 'cloudinary'
NEXT_PUBLIC_IMAGE_STORAGE=local

# For Supabase storage
NEXT_PUBLIC_SUPABASE_BUCKET=shoma-images

# For Cloudinary
NEXT_PUBLIC_CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── M-PESA (SAFARICOM DARAJA API) ────────────────────────────────────────────
# From: https://developer.safaricom.co.ke/ → My Applications
# Environment: sandbox or production
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd1a503b6e68bc1609113064d2b56e3993aeddbd09

# Callbacks
MPESA_CALLBACK_URL=http://localhost:3000/api/mpesa/callback

# B2C Payments (caretaker payouts)
MPESA_SECURITY_CREDENTIAL=encrypted_password_from_safaricom

# ─── ADMIN AUTHENTICATION ─────────────────────────────────────────────────────
# Admin login credentials (for development only)
# In production: Use Supabase Auth with proper email verification
ADMIN_EMAIL=admin@shoma.nl
ADMIN_PASSWORD=change_me_in_production

# JWT Secret for admin sessions
JWT_SECRET=your_secret_key_min_32_chars_long_random_string

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
